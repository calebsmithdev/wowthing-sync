{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "strict": false,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/types/modules.d.ts",
    "env.d.ts",
    "**/*"
  ]
}
