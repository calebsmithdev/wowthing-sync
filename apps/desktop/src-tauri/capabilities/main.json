{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:default",
    "os:default",
    "autostart:default",
    "notification:default",
    "log:default",
    "shell:allow-open"
  ]
}
