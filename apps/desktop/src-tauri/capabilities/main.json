{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:default",
    "os:default",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/calebsmithdev/wowthing-sync/releases/latest" }]
    },
    "notification:allow-is-permission-granted"
  ]
}
